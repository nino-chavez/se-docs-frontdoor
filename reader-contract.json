          "replacement": "our documentation"
        },
        {
          "term": "connector",
          "reason": "implementation detail with no bearing on the decision",
          "replacement": "connection"
        },
        {
          "term": "federated",
          "reason": "architecture vocabulary",
          "replacement": "searches across"
        },
        {
          "term": "retrieval",
          "reason": "architecture vocabulary",
          "replacement": "search"
        },
        {
          "term": "invalidation",
          "reason": "our internal term for the core gap",
          "replacement": "knowing when a document became wrong"
        },
        {
          "term": "RAG",
          "reason": "acronym no executive should have to decode"
        },
        {
          "term": "vector",
          "reason": "implementation detail"
        },
        {
          "term": "embedding",
          "reason": "implementation detail"
        },
        {
          "term": "schema",
          "reason": "implementation detail"
        },
        {
          "term": "Vendor Intake",
          "reason": "internal process name; say what it means instead",
          "replacement": "a new purchase"
        },
        {
          "term": "AI Use Case Review",
          "reason": "internal process name",
          "replacement": "the standard approval"
        }
      ],
      "maxWordsPerText": 70
    },
    {
