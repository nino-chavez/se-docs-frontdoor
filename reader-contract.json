      "sourceRoots": [
        "docs/se-team-brief.html",
        "research",
        "decisions"
      ],
      "allowTerms": [
        "AI",
        "SE",
        "Slack"
      ],
      "denyTerms": [],
      "maxWordsPerText": 90
    },
    {
      "name": "Solution plan",
      "renderedRoots": [
        "docs/solution-plan.html"
      ],
      "sourceRoots": [
        "docs/solution-plan.md",
        "research",
        "decisions"
      ],
