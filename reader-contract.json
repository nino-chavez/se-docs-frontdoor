        {
          "term": "vector",
          "reason": "implementation detail"
        },
        {
          "term": "embedding",
          "reason": "implementation detail"
        }
      ],
      "maxWordsPerText": 95
    },
    {
      "name": "initiative portal",
      "renderedRoots": [
        "apps/portal/dist"
      ],
      "sourceRoots": [
