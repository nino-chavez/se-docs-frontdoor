      "job": "find the governing decision, evidence, and next action without reconstructing the project history",
      "assumedKnowledge": [
        "software product work",
        "solution engineering"
      ],
      "plainness": "specialist",
      "precisionLocks": [
        "decision identifiers",
        "citations",
