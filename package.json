{
  "name": "se-docs-frontdoor-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/portal",
    "build": "npm run build -w apps/portal",
    "typecheck": "npm run typecheck -w apps/portal",
    "reader:check": "node tools/lib/encounter-audit.mjs --root=. --strict",
    "manifest:check": "BP=\"${BLUEPRINT_HOME:-$HOME/Workspace/dev/tools/blueprint}\"; node \"${BP/#\\~/$HOME}/template/tools/lib/actor-output.mjs\" actor-output.yml --root .",
    "manifest:gate": "BP=\"${BLUEPRINT_HOME:-$HOME/Workspace/dev/tools/blueprint}\"; node \"${BP/#\\~/$HOME}/template/tools/lib/actor-output.mjs\" actor-output.yml --root . --gate",
    "derive": "BP=\"${BLUEPRINT_HOME:-$HOME/Workspace/dev/tools/blueprint}\"; node \"${BP/#\\~/$HOME}/template/tools/lib/account-derive.mjs\" --root ."
  }
}
